      "id": "f23a9941-8dca-4a17-8e1c-63bb18b1c865",
      "name": "Combine Stories",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1328,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine all stories into ONE message for Discord.\nconst items = $input.all();\nconst lines = items.map((item, n) => {\n  const s = item.json;\n  const link = s.url || ('https://news.ycombinator.com/item?id=' + s.id);\n  return s.label + ' ' + (n + 1) + '. ' + s.title + '\\n' + s.score + ' points | ' + (s.descendants ?? 0) + ' comments\\n' + link;\n});\nconst message = '📰 Morning Brief: Top 5 on Hacker News\\n\\n' + lines.join('\\n\\n');\nreturn [{ json: { message } }];"
      },
      "id": "b6f5a2f1-1856-4653-9cb3-8160f8f7b7c2",
