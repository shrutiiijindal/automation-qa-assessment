        "options": {}
      },
      "id": "f2f1c2a6-36cf-450f-bd86-6d8c6ca1205c",
      "name": "Get Top Story IDs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        176
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Take the HackerNews response and keep only the first 5 story IDs.\nconst all = $input.all();\nlet ids = [];\nif (all.length === 1 && Array.isArray(all[0].json)) {\n  ids = all[0].json;\n} else if (all.length === 1 && Array.isArray(all[0].json.data)) {\n  ids = all[0].json.data;\n} else {\n  ids = all.map(i => (typeof i.json === 'object' ? (i.json.data ?? i.json.id ?? Object.values(i.json)[0]) : i.json));\n}\nids = ids.slice(0, 5);\n// Return one item per ID so the next node runs once per story\nreturn ids.map(id => ({ json: { id } }));"
      },
      "id": "ef599588-3619-4daa-af29-b2cedc7b2f9b",
      "name": "Keep Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        80
      ]
    },
